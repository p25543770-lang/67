{
  "name": "depth-studio",
  "version": "1.1.0",
  "private": true,
  "description": "Experimental depth-camera room scanning and point-cloud viewer.",
  "author": "Depth Studio contributors",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:python": "python -m unittest discover -s tests -p 'test_*.py'",
    "build:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.4.5"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "studio.depthstudio.desktop",
    "compression": "store",
    "productName": "Depth Studio",
    "files": [
      "dist/**/*",
      "desktop/**/*"
    ],
    "extraResources": [
      {
        "from": "server.py",
        "to": "server.py"
      },
      {
        "from": "sensor_drivers",
        "to": "sensor_drivers"
      },
      {
        "from": "requirements-scan.txt",
        "to": "requirements-scan.txt"
      },
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Depth-Studio-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Depth Studio",
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "release"
    }
  }
}
