{
  "name": "depth-studio",
  "version": "1.2.6",
  "private": true,
  "description": "Experimental depth-camera room scanning and point-cloud viewer.",
  "author": "Depth Studio contributors",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:python && npm run test:desktop",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:desktop": "node --test desktop/tests/*.test.cjs",
    "prepare:python": "node scripts/prepare-python-runtime.mjs",
    "check:python-bundle": "node scripts/prepare-python-runtime.mjs --check",
    "lock:python": "node scripts/make-python-lock.mjs --wheels python-bundle/wheels --pip-wheel python-bundle/wheels/pip-24.2-py3-none-any.whl",
    "build:win": "npm run prepare:python && npm run build && electron-builder --win nsis --x64",
    "check:python-lock": "python scripts/check-windows-lock.py",
    "resolve:python": "python scripts/resolve-windows-deps.py --dest python-bundle/wheels"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.4.5"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "studio.depthstudio.desktop",
    "compression": "store",
    "productName": "Depth Studio",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "!desktop/tests/**",
      "!desktop/**/*.test.cjs"
    ],
    "extraResources": [
      {
        "from": "server.py",
        "to": "server.py"
      },
      {
        "from": "sensor_drivers",
        "to": "sensor_drivers"
      },
      {
        "from": "scan_pipeline",
        "to": "scan_pipeline",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "scripts/benchmark-synthetic-fps.py",
        "to": "scripts/benchmark-synthetic-fps.py"
      },
      {
        "from": "scripts/benchmark-tracking-stability.py",
        "to": "scripts/benchmark-tracking-stability.py"
      },
      {
        "from": "scripts/benchmark-robot-turn.py",
        "to": "scripts/benchmark-robot-turn.py"
      },
      {
        "from": "tests/synthetic_room.py",
        "to": "tests/synthetic_room.py"
      },
      {
        "from": "tests/synthetic_robot.py",
        "to": "tests/synthetic_robot.py"
      },
      {
        "from": "requirements-scan.txt",
        "to": "requirements-scan.txt"
      },
      {
        "from": "requirements-scan.lock.txt",
        "to": "requirements-scan.lock.txt"
      },
      {
        "from": "python-lock.json",
        "to": "python-lock.json"
      },
      {
        "from": "python-bundle/manifest.json",
        "to": "python-bundle-manifest.json"
      },
      {
        "from": "python-bundle/runtime",
        "to": "python-runtime"
      },
      {
        "from": "python-bundle/wheels",
        "to": "python-wheels"
      },
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Depth-Studio-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Depth Studio",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "release"
    }
  }
}
